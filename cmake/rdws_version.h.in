#include <cstdlib>

namespace rdws {

// Version of the solution: `git describe` of the build (e.g. "v0.1.0", "v0.1.0-3-g1a2b3c4").
inline constexpr const char* kVersion = "@RDWS_VERSION_EFFECTIVE@";

// The version a process reports: `fromEnv` (RDWS_VERSION) when set and not empty, else the
// compiled one. Separate from version() so it can be tested without touching the environment.
[[nodiscard]] inline const char* versionFrom(const char* fromEnv) {
  return (fromEnv != nullptr && *fromEnv != '\0') ? fromEnv : kVersion;
}

// The version of the solution at runtime. The Docker images set RDWS_VERSION (Dockerfile, runtime
// stage) instead of compiling it in, so the compile layer doesn't depend on the commit and the
// CI of a merge reuses the one its PR built. Local builds don't set it and keep kVersion, the
// `git describe` they were configured with. Read once.
[[nodiscard]] inline const char* version() {
  static const char* const value = versionFrom(std::getenv("RDWS_VERSION"));
  return value;
}

// Version of the HTTP API contract. Only goes up when the contract breaks, so clients (rdws_web)
// depend on it instead of on every release (README, "Versões").
inline constexpr int kApiVersion = 2;

} // namespace rdws

meta {
  name: List Fields
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/fields?farm_id={{farmId}}
  body: none
  auth: bearer
}

params:query {
  farm_id: {{farmId}}
}

auth:bearer {
  token: {{jwtToken}}
}

script:post-response {
  // Without a field created in this session, Get/Update/Delete Field use the first one listed
  if (res.status === 200 && !bru.getVar("fieldId") && res.body.data.length > 0) {
    bru.setVar("fieldId", res.body.data[0].id);
  }
}

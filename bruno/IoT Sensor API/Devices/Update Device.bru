meta {
  name: Update Device
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/devices/:devId
  body: json
  auth: bearer
}

params:path {
  devId: {{deviceId}}
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "type": "weather_station",
    "status": "active",
    "elevation_m": 812.4
  }
}

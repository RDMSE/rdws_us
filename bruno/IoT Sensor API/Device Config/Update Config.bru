meta {
  name: Update Config
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/devices/:devId/config
  body: json
  auth: bearer
}

params:path {
  devId: 12
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "config": {
      "agg_window_s": 120,
      "onboard": [
        {
          "enabled": true,
          "chan": "temp",
          "sensor_id": 31
        }
      ]
    }
  }
}

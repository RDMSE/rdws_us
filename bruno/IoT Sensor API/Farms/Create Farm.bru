meta {
  name: Create Farm
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/farms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "name": "Fazenda São João",
    "location": { "lat": -15.7801, "lng": -47.9292 },
    "timezone": "America/Sao_Paulo"
  }
}

script:post-response {
  // Farms are addressed by their public id (UUID); Get/Update/Delete Farm use it
  if (res.status === 201) {
    bru.setVar("farmId", res.body.data.id);
  }
}
